# =============================================================
# SPREADSTER — AI Spreadsheet Operating System
# College Administration Internal Platform
# Copy this to .env and fill in all values
# =============================================================

# --- DATABASE (PostgreSQL) ---
DATABASE_URL="postgresql://spreadster_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/spreadster_db"

# --- SECURITY ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_GENERATE_32_CHAR_SECRET"
JWT_EXPIRES_IN="8h"
SESSION_SECRET="CHANGE_ME_GENERATE_32_CHAR_SESSION_SECRET"
# Internal API key used by the GAS extension to authenticate requests
API_KEY="CHANGE_ME_GENERATE_32_CHAR_API_KEY"
# Used for encrypting sensitive data at rest
ENCRYPTION_KEY="CHANGE_ME_GENERATE_32_CHAR_ENCRYPT_KEY"

# --- GOOGLE OAUTH ---
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://your-backend.vercel.app/api/auth/google/callback"

# --- FREE CLOUD AI PROVIDERS ---
# Add at least ONE key. Provider priority: Gemini → Groq → OpenRouter → Ollama (optional local).
# The system auto-selects the first provider that has a key set.

# 1. Google Gemini 2.0 Flash (RECOMMENDED — best for JSON generation)
#    Free: 15 RPM, 1 million tokens/day, 1500 requests/day — no credit card needed
#    Get key: https://aistudio.google.com/app/apikey (sign in with Google, 30 seconds)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"

# 2. Groq — Llama 3.3 70B (fast fallback)
#    Free: 14,400 tokens/min, 500 requests/day — no credit card needed
#    Get key: https://console.groq.com/keys (sign up, instantly available)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"

# 3. OpenRouter (secondary fallback with free models)
#    Free models available, no credit card for free tier
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key-here"
OPENROUTER_MODEL="meta-llama/llama-3.1-8b-instruct:free"

# 4. Ollama (optional — only if you have a strong local machine)
#    Leave blank to skip. If set, used as last-resort fallback.
OLLAMA_BASE_URL=""
OLLAMA_MODEL="deepseek-coder:6.7b"

# --- AI TUNING ---
AI_TEMPERATURE="0.1"
AI_TIMEOUT_MS="60000"

# --- FRONTEND ---
VITE_API_BASE_URL="https://your-backend.vercel.app/api"
VITE_APP_VERSION="1.0.0"
VITE_COLLEGE_NAME="Your College Name"
VITE_COLLEGE_SHORT_NAME="YC"
VITE_COLLEGE_LOGO_URL=""
NEXT_PUBLIC_API_BASE_URL="https://your-backend.vercel.app/api"

# --- CORS ---
ALLOWED_ORIGINS="https://your-frontend.vercel.app,https://docs.google.com,https://n-xxxxx.googleusercontent.com"

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="30"
RATE_LIMIT_AI_MAX="10"

# --- LOGGING ---
LOG_LEVEL="info"
LOG_FORMAT="json"

# --- SERVER ---
PORT="3001"
NODE_ENV="development"

# --- EMAIL (optional - for notifications) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="spreadster@yourcollege.edu"
